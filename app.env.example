# App settings. Copy to app.env (never commit it). Used by docker compose and by a local run.

# ---- Sign-in ------------------------------------------------------------------------------------
# Recommended: Cloudflare Access does the sign-in and the app verifies its signed token on every request.
# Zero Trust, Settings shows your team domain; the AUD tag is on the Access application's Overview tab.
RT_ACCESS_TEAM_DOMAIN=
RT_ACCESS_AUD=
# Optional second check inside the app: only these emails (comma-separated) are accepted even if Access lets others in.
RT_ACCESS_EMAILS=
RT_PUBLIC_URL=https://receipts.abalakrishnan.in

# Without Cloudflare Access (for example a plain local run): a password hash for the browser login.
#   docker compose run --rm --no-deps app python -m app.auth       (or: python -m app.auth)
# Paste the RT_PASSWORD_HASH='...' line it prints. Keep the single quotes.
RT_PASSWORD_HASH=
# Optional long random token for scripts (openssl rand -hex 32), sent as "Authorization: Bearer <token>".
# Not needed for the iPhone Shortcut when you use an Access service token.
RT_TOKEN=

# ---- AI extraction: any server that implements the OpenAI Chat Completions API with image input.
RT_LLM_API_KEY=
# Other providers or local servers, for example:
#   OpenRouter:  RT_LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:      RT_LLM_BASE_URL=http://localhost:11434/v1   (no key needed; use a vision model)
#   Gemini:      RT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Anthropic:   RT_LLM_BASE_URL=https://api.anthropic.com/v1  (images only; set RT_PDF_MODE=images)
RT_LLM_BASE_URL=
# Must be a vision-capable model on that provider. Measure accuracy before choosing a cheaper one.
RT_MODEL=gpt-4o
# PDFs: auto (render pages to images if PyMuPDF is installed, else send the PDF natively), images, or file.
RT_PDF_MODE=auto
# Set to 0 if your server rejects response_format=json_object.
RT_JSON_MODE=1

# ---- Encryption key for stored receipts and backups -------------------------------------------------
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Also store a copy in your password manager. Without it, stored receipts and backups cannot be read.
RT_KEY=

# ---- Email intake (optional): a dedicated mailbox you forward receipts to ------------------------------
# Gmail: enable 2-step verification, then create an App Password. Use a mailbox that receives nothing else.
RT_IMAP_HOST=
RT_IMAP_USER=
RT_IMAP_PASSWORD=
# Comma-separated addresses allowed to send receipts in (your own). Nothing is read unless this is set.
RT_MAIL_ALLOWED_SENDERS=
# Address shown in the app. Defaults to RT_IMAP_USER.
RT_MAIL_ADDRESS=
# Require the mail provider to have verified the sender (dmarc=pass). Turn off only for providers that do not add the header.
RT_MAIL_REQUIRE_AUTH=1
RT_MAIL_POLL_SECONDS=120

# ---- Phone notifications (optional, ntfy) ---------------------------------------------------------------
# A public topic name is the only secret: make it long and random. Messages hold counts only unless RT_NTFY_DETAILS=1.
RT_NTFY_URL=
RT_NTFY_TOKEN=
RT_NTFY_DETAILS=0

# ---- Behaviour ------------------------------------------------------------------------------------------
# Fields below this model confidence send the receipt to the review queue (0 to 1).
RT_CONFIDENCE_THRESHOLD=0.8
RT_SESSION_DAYS=30
